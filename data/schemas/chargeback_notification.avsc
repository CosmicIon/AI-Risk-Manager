{
  "type": "record",
  "name": "ChargebackNotification",
  "namespace": "com.airiskmanager.events",
  "fields": [
    {"name": "notification_id", "type": "string"},
    {"name": "network", "type": "string"},
    {"name": "arn", "type": "string"},
    {"name": "raw_reason_code", "type": "string"},
    {"name": "reason_code", "type": "string"},
    {"name": "transaction_id", "type": "string"},
    {"name": "transaction_date", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "transaction_amount", "type": {"type": "bytes", "logicalType": "decimal", "precision": 15, "scale": 2}},
    {"name": "currency", "type": "string", "default": "INR"},
    {"name": "cardholder_name", "type": ["null", "string"], "default": null},
    {"name": "merchant_id", "type": "string"},
    {"name": "tenant_id", "type": "string", "logicalType": "uuid"},
    {"name": "received_at", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "deadline", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null}
  ]
}
