{
  "type": "record",
  "name": "TransactionEvent",
  "namespace": "com.airiskmanager.events",
  "fields": [
    {"name": "event_id", "type": "string"},
    {"name": "tenant_id", "type": "string", "logicalType": "uuid"},
    {"name": "transaction_id", "type": "string"},
    {"name": "timestamp", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "amount", "type": {"type": "bytes", "logicalType": "decimal", "precision": 15, "scale": 2}},
    {"name": "currency", "type": "string"},
    {"name": "merchant_id", "type": "string"},
    {"name": "merchant_category_code", "type": "string"},
    {"name": "customer_id", "type": "string"},
    {"name": "payment_method", "type": "string"},
    {"name": "device_fingerprint", "type": ["null", "string"], "default": null},
    {"name": "ip_address", "type": ["null", "string"], "default": null},
    {"name": "city", "type": ["null", "string"], "default": null},
    {"name": "country", "type": "string", "default": "IN"}
  ]
}
