# ==============================================================================
# Environment Configuration Template — AI Risk Manager
# ==============================================================================

# Application & Runtime
ENVIRONMENT=dev
DEBUG=true
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Security & Authentication
JWT_SECRET=super_secret_jwt_signing_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Primary Relational Store (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://riskmanager:dev_password@localhost:5432/riskmanager
DATABASE_SYNC_URL=postgresql://riskmanager:dev_password@localhost:5432/riskmanager

# Cache, Session, and Rate-Limiting Store (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Event Bus & Streaming (Apache Kafka - KRaft Mode)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=ai-risk-manager-backend

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Entity Graph Store (Neo4j 5 GDS)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=dev_password

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_REGION=ap-south-1
S3_BUCKET_MODELS=models
S3_BUCKET_HOLDOUT=holdout
S3_BUCKET_EVIDENCE=evidence
S3_BUCKET_REPORTS=reports

# AI / ML Model Providers
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# LLM Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-local-placeholder
LANGFUSE_SECRET_KEY=sk-lf-local-placeholder
LANGFUSE_HOST=http://localhost:3001

# OpenTelemetry Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ai-risk-manager-backend
